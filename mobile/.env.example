# Forte Options mobile app — environment variables
#
# Copy this file to `.env` (never commit `.env`) and fill in the values from
# your Supabase project dashboard: Settings → API.
#
# ONLY the public anon key belongs here. Never put the service-role key or any
# database password in this app — privileged writes happen exclusively inside
# the `create-order` Supabase Edge Function.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
